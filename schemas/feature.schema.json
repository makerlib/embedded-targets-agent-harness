{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-targets.ai/schemas/feature.schema.json",
  "title": "Feature contract",
  "description": "Spec v1.1.1 \u00a79.4.1 minimum schema. verification_method is checked by lint, not the schema, so a missing method reports ACCEPTANCE_CRITERION_UNVERIFIABLE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "profile",
    "objective",
    "acceptance_criteria",
    "scope",
    "verification",
    "approvals",
    "rework",
    "intake"
  ],
  "properties": {
    "api_version": {
      "type": "string"
    },
    "kind": {
      "const": "FeatureContract"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "target_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "id",
        "title",
        "owner"
      ]
    },
    "profile": {
      "enum": [
        "full",
        "lite"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "enum": [
              "gate",
              "human_review"
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._<>-]*$"
            },
            "uniqueItems": true
          },
          "expected_on_baseline": {
            "enum": [
              "fail",
              "pass"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qe_test_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowed_paths",
        "protected_paths"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6"
          ]
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._<>-]*$"
          },
          "uniqueItems": true
        },
        "qe_test_design": {
          "enum": [
            "required",
            "optional",
            "off"
          ]
        }
      },
      "required": [
        "required_level",
        "required_gates"
      ]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "class"
            ]
          }
        }
      },
      "required": [
        "required"
      ]
    },
    "rework": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "maximum_cycles"
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drafted_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_content_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "drafted_by",
        "approved_by",
        "approval_ref"
      ]
    }
  }
}
