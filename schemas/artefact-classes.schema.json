{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-targets.ai/schemas/artefact-classes.schema.json",
  "title": "Artefact classes",
  "description": "Project additions to the built-in artefact classes (\u00a79.21). Patterns are scope globs; built-in defaults always apply.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "model": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "harness": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
